  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime main action.",
      "html": "<a class=\"ds-button\" href=\"#example\" dir=\"rtl\">פתיחת הכלי</a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:43px;padding:8px 15px;border:1px solid var(--ink);font:700 16px/1.4 var(--font);text-decoration:none;transition:transform 160ms var(--ease),box-shadow 160ms var(--ease),background 160ms}.ds-button:hover{box-shadow:3px 3px 0 var(--ink);transform:translate(-2px,-2px)}.ds-button:active{box-shadow:none;transform:translate(1px,1px)}.ds-button:focus-visible{outline:3px solid var(--ink);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:hover,.ds-button:active{transform:none}}.ds-button{background:var(--accent);color:var(--accent-ink);border-color:var(--accent-ink)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined surface action.",
      "html": "<a class=\"ds-button\" href=\"#example\" dir=\"rtl\">הורדה</a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:43px;padding:8px 15px;border:1px solid var(--ink);font:700 16px/1.4 var(--font);text-decoration:none;transition:transform 160ms var(--ease),box-shadow 160ms var(--ease),background 160ms}.ds-button:hover{box-shadow:3px 3px 0 var(--ink);transform:translate(-2px,-2px)}.ds-button:active{box-shadow:none;transform:translate(1px,1px)}.ds-button:focus-visible{outline:3px solid var(--ink);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:hover,.ds-button:active{transform:none}}.ds-button{background:var(--surface);color:var(--ink)}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Full-field outline for keyboard focus.",
      "html": "<label class=\"ds-search\" dir=\"rtl\"><input aria-label=\"חיפוש כלים\" placeholder=\"חיפוש כלים\"></label>",
      "css": ".ds-search{display:flex;align-items:center;min-height:54px;padding:0 17px;border:1px solid var(--ink);background:var(--surface);color:var(--ink)}.ds-search:focus-within{outline:2px solid var(--ink);outline-offset:3px}.ds-search input{width:100%;min-width:0;height:52px;border:0;outline:none;background:none;color:inherit;font:18px var(--font)}.ds-search input::placeholder{color:var(--muted);opacity:1}"
    },
    {
      "name": "Category navigation",
      "kind": "nav",
      "refersTo": "category-current",
      "description": "Current category inverts ink and paper; mobile links wrap.",
      "html": "<nav class=\"ds-nav\" aria-label=\"קטגוריות\" dir=\"rtl\"><a href=\"#web\" aria-current=\"page\">כלי דפדפן</a><a href=\"#scripts\">סקריפטים</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;font:16px var(--font)}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:9px 11px;border:1px solid transparent;text-decoration:none;color:var(--ink);transition:background 160ms,border-color 160ms}.ds-nav a:hover{background:var(--hero);border-color:var(--line)}.ds-nav a[aria-current]{background:var(--ink);color:var(--paper);border-color:var(--ink)}.ds-nav a:focus-visible{outline:3px solid var(--ink);outline-offset:5px}@media(max-width:780px){.ds-nav{flex-direction:row;flex-wrap:wrap;gap:6px}.ds-nav a{padding:8px 10px;border-color:var(--line);font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Tool card",
      "kind": "card",
      "refersTo": "tool-card",
      "description": "Flat directory cell with tonal hover.",
      "html": "<article class=\"ds-card\" dir=\"rtl\"><h3>כלי שימושי</h3><p>כלים שימושיים. קוד פתוח. מקום לרעיונות חדשים.</p><a href=\"#source\">קוד מקור</a></article>",
      "css": ".ds-card{padding:23px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font:16px/1.65 var(--font);transition:background 200ms}.ds-card:hover{background:var(--hero)}.ds-card h3{margin:0 0 12px;font:700 24px/1.16 var(--font)}.ds-card p{margin:0;color:var(--muted);max-width:65ch}.ds-card a{display:inline-flex;align-items:center;min-height:36px;margin-top:22px;color:inherit;font-size:14px;text-underline-offset:4px}.ds-card a:focus-visible{outline:3px solid var(--ink);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
