      "css": ".ds-drawer{display:flex;align-items:center;min-height:49px;padding:8px 14px;border:1px solid #afc393;background:#334b3c;color:#edf4df;text-decoration:none;font:600 18px var(--font);transition:transform 250ms var(--ease),background 180ms,color 180ms}.ds-drawer:hover,.ds-drawer:focus-visible{transform:translateX(-9px);background:var(--accent);color:var(--accent-ink)}.ds-drawer:focus-visible{outline:3px solid var(--accent);outline-offset:5px}.ds-drawer:active{transform:translateX(-4px)}@media(prefers-reduced-motion:reduce){.ds-drawer{transition:none}.ds-drawer:hover,.ds-drawer:active{transform:none}}"
    }
