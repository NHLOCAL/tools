    "bundle": "npm run docs:sync && npx --yes @anthropic-ai/mcpb pack"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  }
}
